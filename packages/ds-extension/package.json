{
  "name": "@createos/dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness provider family that places the agent's filesystem and process execution world inside a remote CreateOS Sandbox",
  "keywords": [
    "createos",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "author": "CreateOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodeOps-app/createos-claude-plugins.git",
    "directory": "packages/ds-extension"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fs": {
      "types": "./lib/types/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./subprocess": {
      "types": "./lib/types/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "bun test src",
    "smoke": "bun scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt --write"
  },
  "dependencies": {
    "@nodeops-createos/sandbox": "0.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/bun": "1.3.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
    "js-yaml": "4.1.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "6.0.3"
  }
}
