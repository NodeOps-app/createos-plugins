{
  "name": "@nodeops-createos/codex-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "engines": { "node": ">=22" },
  "overrides": { "esbuild": "$esbuild" },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "esbuild": "0.28.2",
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  }
}
