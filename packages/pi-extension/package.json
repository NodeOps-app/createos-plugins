{
  "name": "@createos/pi",
  "version": "0.2.0",
  "description": "Pi coding agent extension that runs all tool calls inside a remote CreateOS Sandbox while the agent runs locally",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodeOps-app/pi-extension.git"
  },
  "author": "CreateOS",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "createos",
    "sandbox"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
