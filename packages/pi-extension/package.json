  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-ai": "^0.79.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-ai": "^0.79.0",
    "@types/node": "^22",
    "typebox": "1.1.38",
    "typescript": "^5.6.0"
  }
}
